{
  "name": "southbag-terminal",
  "productName": "Southbag Terminal",
  "version": "2.0.0",
  "description": "The official terminal emulator of the Southbag Global Enterprise Network.",
  "main": "src/main/main.js",
  "private": true,
  "homepage": "https://southbag.cc",
  "repository": {
    "type": "git",
    "url": "https://github.com/SouthbagHQ/terminal.git"
  },
  "author": {
    "name": "Southbag Global Enterprise Network",
    "email": "engineering@southbag.cc"
  },
  "license": "Unlicense",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "cc.southbag.terminal",
    "productName": "Southbag Terminal",
    "artifactName": "southbag-terminal-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "linux": {
      "icon": "build/icon.png",
      "category": "System",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "maintainer": "Southbag Global Enterprise Network <engineering@southbag.cc>",
      "synopsis": "Southbag's official enterprise terminal emulator"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
